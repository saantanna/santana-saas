# Copie para .env e ajuste. O arquivo .env NUNCA deve ir para o Git.
PORT=3000
HOST=127.0.0.1
# "production" ativa cookie Secure + HSTS (use somente atrás de HTTPS)
NODE_ENV=production
# 1 se estiver atrás de proxy reverso (Caddy/Nginx/Cloudflare) que define X-Forwarded-For
TRUST_PROXY=0
# Dias até apagar automaticamente pedidos antigos (política de privacidade diz 12 meses)
RETENTION_DAYS=365

# Alertas no celular mesmo com o painel fechado (opcionais; só enviam nome + tipo do projeto)
# ntfy: instale o app ntfy e assine um tópico com nome longo e aleatório
NTFY_URL=
# Telegram: crie um bot no @BotFather e descubra seu chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
